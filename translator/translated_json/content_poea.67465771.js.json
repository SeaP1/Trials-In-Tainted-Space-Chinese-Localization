      "category": "dialogue",
      "context": "output[0]",
      "shouldTranslate": true,
      "shouldTranslated": true,
      "original": "\n\nYou should only proceed if you are definitely sure you want to travel here.",
      "translation": "\n\n只有在你完全确定自己想来这里时，才应该继续。",
      "start": 1786,
      "end": 1867,
      "line": 33,
      "raw": "\"\\n\\nYou should only proceed if you are definitely sure you want to travel here.\"",
      "translationStatus": "manual_translated",
