    },
    {
      "id": "content_poea.67465771.js:1977:2203:5887ed454f67",
      "file": "content_poea.67465771.js",
      "category": "dialogue",
      "context": "output[0]",
      "shouldTranslate": true,
      "shouldTranslated": true,
      "original": "\n\n(Poe A is intended to be experienced as a one-time event. <b>Revisiting this location is non-canon and will be treated as if you have been there for the very first time.</b> Keep that in mind and have a Happy Halloween!)",
      "translation": "\n\n(坡A星被设计为一次性活动。<b>再次造访此地不属于正史，系统会将其视为你第一次来到这里。</b>请记住这一点，祝你万圣节快乐！)",
      "start": 1977,
      "end": 2203,
      "line": 37,
      "raw": "\"\\n\\n(Poe A is intended to be experienced as a one-time event. <b>Revisiting this location is non-canon and will be treated as if you have been there for the very first time.</b> Keep that in mind and have a Happy Halloween!)\"",
      "translationStatus": "manual_translated",
