    {
      "id": "content_poea.67465771.js:1553:1729:a1f7fc3d8201",
      "file": "content_poea.67465771.js",
      "category": "dialogue",
      "context": "output[0]",
      "shouldTranslate": true,
      "shouldTranslated": true,
      "original": "Recalling what you’ve read in the invitation letter, the parties held at this location may have a tendency to get way out of hand, <b>resulting in permanent consequences.</b>",
      "translation": "想起邀请函里的内容，这里举行的派对似乎很容易彻底失控，<b>并造成永久性的后果。</b>",
      "start": 1553,
      "end": 1729,
      "line": 30,
      "raw": "\"Recalling what you’ve read in the invitation letter, the parties held at this location may have a tendency to get way out of hand, <b>resulting in permanent consequences.</b>\"",
      "translationStatus": "manual_translated",
      "translationModel": "Manual",
      "translatedAt": "2026-10-23T18:12:15.951Z"
    },
    {
      "id": "content_poea.67465771.js:1786:1867:a41d0ab6d3a9",
